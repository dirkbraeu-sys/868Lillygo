#pragma once
/* ---------------------------------------------------------------------------
 *  Vorlage. Kopieren nach  include/secrets.h  und echte Werte eintragen.
 *  (include/secrets.h ist per .gitignore vom Repo ausgeschlossen.)
 * --------------------------------------------------------------------------- */

#define WIFI_SSID     "DEIN_WLAN_NAME"
#define WIFI_PASS     "DEIN_WLAN_PASSWORT"   // "" = offenes Netz ohne Passwort
#define WIFI_SSID2    ""                      // optionales Backup-WLAN
#define WIFI_PASS2    ""

// Passwort fuer drahtlose Updates (OTA). Muss mit upload_flags in der
// platformio.ini uebereinstimmen (--auth=...). "" = kein Schutz.
#define OTA_PASSWORD  "DEIN_OTA_PASSWORT"

// Passwort fuer den Setup-Hotspot, den das Board aufmacht, wenn es kein
// bekanntes WLAN findet. Mind. 8 Zeichen (WPA2-Minimum).
#define AP_SETUP_PASSWORD "DEIN_HOTSPOT_PASSWORT"

// --- MQTT (fuer Home Assistant) -------------------------------------------
// Broker-Adresse. Bei HA meist der Mosquitto-Add-on auf dem HA-Host.
#define MQTT_HOST     "192.168.178.81"
#define MQTT_PORT     1883
#define MQTT_USER     "DEIN_MQTT_BENUTZER"
#define MQTT_PASS     "DEIN_MQTT_PASSWORT"

// --- ntfy.sh (Push-Meldungen bei Schwellenwert-Ueberschreitung) -----------
// Eigenes, zufaelliges Topic waehlen (ntfy-Topics sind oeffentlich lesbar,
// wenn der Name bekannt ist) und in der ntfy-App abonnieren.
#define NTFY_TOPIC    "DEIN_EIGENES_NTFY_TOPIC"

#define THINGSPEAK_API_KEY  ""
